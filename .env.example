# Copy to .env and fill in. Never commit .env.
# Azure AI Content Safety resource (Keys and Endpoint blade in the Azure portal)
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=<key>

# Optional: name of a text blocklist in the same resource (see scripts/setup_blocklist.py)
# AZURE_CONTENT_SAFETY_BLOCKLIST=lab-sensitive-terms

# Optional: harm severity that counts as a block: 2 (low), 4 (medium, default), 6 (high)
# LAB_HARM_THRESHOLD=4

# Optional: where evaluation history is stored (default: data/lab.db)
# LAB_DB_PATH=data/lab.db
